{
  "name": "my-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:fe": "npm run test --workspace=web",
    "test:be": "npm run test --workspace=api",
    "test:all": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "turbo": "2.11.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@10.9.2"
}
